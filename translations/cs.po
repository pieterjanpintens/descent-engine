msgid "Lucky Charm: %d extra success is added to %s's result."
msgid_plural "Lucky Charm: %d extra successes are added to %s's result."
msgstr[0] "Šťastný talisman: %d úspěch navíc se přičítá k výsledku hrdiny %s."
msgstr[1] "Šťastný talisman: %d úspěchy navíc se přičítají k výsledku hrdiny %s."
msgstr[2] "Šťastný talisman: %d úspěchů navíc se přičítá k výsledku hrdiny %s."

