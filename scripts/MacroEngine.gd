class_name MacroEngine
extends RefCounted

## Applies, regenerates and removes macros (see MissionMacro). Pure data work on a MissionData: it never touches the scene, so callers wrap
## it in the editor's undo history (operation_history.record) and call layered_map.notify_objects_changed() afterwards (MacroDialog does).
##
## What a macro generated is remembered in the AppliedMacro on the target (OutlineNode.macros): generated variables, prop actions and
## triggers by identity, plus a fingerprint of how they looked when built, so a hand-edit can be noticed before a regenerate replaces it.


## Applies `macro` to `target` with `values` (completed with defaults) and returns the record that was added to target.macros.
static func apply(mission: MissionData, target: OutlineNode, macro: MissionMacro, values: Dictionary) -> AppliedMacro:
	var applied := _build(mission, target, macro, values)
	target.macros.append(applied)
	return applied


## Replaces what `old` generated by what `macro` builds from the new `values`, keeping the record's place in target.macros. The names of
## the generated variables are reused (they are freed first), so references to them elsewhere stay valid.
static func reapply(mission: MissionData, target: OutlineNode, old: AppliedMacro, macro: MissionMacro, values: Dictionary) -> AppliedMacro:
	var index := target.macros.find(old)
	var slot := _first_action_slot(mission, old)  # where the old action sat in its prop's list: the new one goes back there
	_remove_generated(mission, old)
	var fresh := _build(mission, target, macro, values)
	if not slot.is_empty():
		_move_actions_to(slot["entry"], fresh.action_ids, slot["index"])
	if index >= 0:
		target.macros[index] = fresh
	else:
		target.macros.append(fresh)
	return fresh


## Deletes everything `applied` generated and the record itself.
static func remove(mission: MissionData, target: OutlineNode, applied: AppliedMacro) -> void:
	_remove_generated(mission, applied)
	target.macros.erase(applied)


## Whether the generated pieces differ from how the macro built them (edited by hand, or deleted).
static func is_modified(mission: MissionData, applied: AppliedMacro) -> bool:
	return fingerprint(mission, applied) != applied.fingerprint


## A text fingerprint of the pieces `applied` generated, as they are now.
static func fingerprint(mission: MissionData, applied: AppliedMacro) -> String:
	var parts: Array[String] = []
	for variable_name in applied.variable_names:
		var found := ""
		for variable in mission.custom_variables:
			if variable.name == variable_name:
				found = _dump(variable)
		parts.append("variable %s: %s" % [variable_name, found if found != "" else "MISSING"])
	for action_id in applied.action_ids:
		var action := _find_action(mission, action_id)
		parts.append("action %s: %s" % [action_id, _dump(action) if action != null else "MISSING"])
	for trigger_id in applied.trigger_ids:
		var trigger := _find_trigger(mission, trigger_id)
		parts.append("trigger %s: %s" % [trigger_id, _dump(trigger) if trigger != null else "MISSING"])
	return "\n".join(parts)


## "" or a sentence for the Problems list: a record whose macro no longer exists.
static func problem(applied: AppliedMacro) -> String:
	if MacroCatalog.find(applied.macro_id) == null:
		return "A macro called '%s' was applied here, but this version of the editor does not know it. Its generated data still works as normal data." % applied.macro_id
	return ""


static func _build(mission: MissionData, target: OutlineNode, macro: MissionMacro, values: Dictionary) -> AppliedMacro:
	var applied := AppliedMacro.new()
	applied.macro_id = macro.id()
	applied.values = _copy_values(macro.completed(values))
	var context := MacroContext.new(mission, target, applied)
	macro.build(context, _copy_values(applied.values))  # a copy: build() may keep or change what it is given without touching the record
	applied.fingerprint = fingerprint(mission, applied)
	return applied


static func _copy_values(values: Dictionary) -> Dictionary:
	var copy := {}
	for key in values:
		var value: Variant = values[key]
		copy[key] = value.duplicate(true) if value is Resource else value
	return copy


static func _remove_generated(mission: MissionData, applied: AppliedMacro) -> void:
	for variable_name in applied.variable_names:
		for variable in mission.custom_variables.duplicate():
			if variable.name == variable_name:
				mission.custom_variables.erase(variable)
	for action_id in applied.action_ids:
		for entry in mission.interactables:
			for action in entry.actions.duplicate():
				if action.action_id == action_id:
					entry.actions.erase(action)
	for trigger_id in applied.trigger_ids:
		for trigger in mission.triggers.duplicate():
			if trigger.id == trigger_id:
				mission.triggers.erase(trigger)


## {"entry": the prop, "index": position} of the first action `applied` generated, or {} when it has none (any more).
static func _first_action_slot(mission: MissionData, applied: AppliedMacro) -> Dictionary:
	for action_id in applied.action_ids:
		for entry in mission.interactables:
			for index in entry.actions.size():
				if entry.actions[index].action_id == action_id:
					return {"entry": entry, "index": index}
	return {}


## Moves the actions with these ids (those found on `entry`) to `index` onwards, keeping their order.
static func _move_actions_to(entry: InteractableEntry, action_ids: Array[String], index: int) -> void:
	var offset := 0
	for action_id in action_ids:
		for action in entry.actions:
			if action.action_id == action_id:
				entry.actions.erase(action)
				entry.actions.insert(mini(index + offset, entry.actions.size()), action)
				offset += 1
				break


static func _find_action(mission: MissionData, action_id: String) -> PropAction:
	for entry in mission.interactables:
		for action in entry.actions:
			if action.action_id == action_id:
				return action
	return null


static func _find_trigger(mission: MissionData, trigger_id: String) -> MissionTrigger:
	for trigger in mission.triggers:
		if trigger.id == trigger_id:
			return trigger
	return null


## A text dump of a Resource's saved fields (recursively, ids of the pieces included) - enough to tell whether it changed.
static func _dump(value: Variant) -> String:
	if value is Resource:
		var parts: Array[String] = []
		for property in value.get_property_list():
			var usage: int = property["usage"]
			if usage & PROPERTY_USAGE_SCRIPT_VARIABLE == 0 or usage & PROPERTY_USAGE_STORAGE == 0:
				continue
			parts.append("%s=%s" % [property["name"], _dump(value.get(property["name"]))])
		return "{" + ",".join(parts) + "}"
	if value is Array:
		var items: Array[String] = []
		for item in value:
			items.append(_dump(item))
		return "[" + ",".join(items) + "]"
	if value is Dictionary:
		var keys: Array = value.keys()
		keys.sort()
		var pairs: Array[String] = []
		for key in keys:
			pairs.append("%s:%s" % [_dump(key), _dump(value[key])])
		return "{" + ",".join(pairs) + "}"
	return var_to_str(value)
